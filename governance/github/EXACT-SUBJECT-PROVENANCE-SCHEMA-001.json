{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-master://governance/github/EXACT-SUBJECT-PROVENANCE-SCHEMA-001",
  "title": "System Master Exact Subject Provenance Receipt 001",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "receipt_id",
    "schema_id",
    "subject_git_sha",
    "workflow",
    "run",
    "runner",
    "toolchain",
    "inputs",
    "gates",
    "outputs",
    "authority_boundaries",
    "standing"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "schema_id": { "const": "EXACT-SUBJECT-PROVENANCE-SCHEMA-001" },
    "subject_git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "run": {
      "type": "object",
      "required": ["id", "attempt", "event", "ref"],
      "properties": {
        "id": { "type": ["string", "integer"] },
        "attempt": { "type": ["string", "integer"] },
        "event": { "type": "string" },
        "ref": { "type": "string" },
        "actor_classification": { "type": "string" }
      }
    },
    "runner": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "enum": ["GITHUB_HOSTED", "A01_SELF_HOSTED", "OTHER_SELF_HOSTED"] },
        "os": { "type": "string" },
        "arch": { "type": "string" },
        "runner_version": { "type": "string" },
        "image_or_environment": { "type": "string" },
        "ephemeral": { "type": "boolean" }
      }
    },
    "toolchain": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "inputs": {
      "type": "object",
      "required": ["source_or_carrier_sha256"],
      "properties": {
        "source_or_carrier_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "freeze_identity": { "type": "string" },
        "resolved_external_parameters": { "type": "object" }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "standing"],
        "properties": {
          "id": { "type": "string" },
          "standing": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"] },
          "evidence": { "type": ["string", "object", "array", "null"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authority_boundaries": {
      "type": "object",
      "required": ["github_exact_subject", "a01_native", "production"],
      "properties": {
        "github_exact_subject": { "type": "boolean" },
        "a01_native": { "type": "boolean" },
        "production": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "standing": { "enum": ["PASS", "FAIL", "BLOCKED", "STALE", "INFRASTRUCTURE_FAILED"] }
  }
}
