{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SYSTEM-MASTER/WORK-OBLIGATION-REGISTRY-001",
  "title": "Work Obligation Registry",
  "description": "The build plan. An obligation with no state or no owner cannot be scheduled, briefed, or closed.",
  "type": "object",
  "required": [
    "registry_id",
    "effective_date",
    "obligations",
    "central_next_objective"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "pattern": "^WORK-OBLIGATION-REGISTRY-\\d{3}$"
    },
    "effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "central_next_objective": {
      "type": "string",
      "minLength": 1
    },
    "highest_discretionary_objective": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "state"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "READY",
              "BLOCKED",
              "HOLD",
              "CLOSED",
              "RETIRED"
            ]
          },
          "owner_path": {
            "type": "string",
            "pattern": "^SYSTEM_MASTER(/[A-Z0-9_]+)*$"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "evidence_target": {
            "type": "string"
          },
          "acceptance_target": {
            "type": "string"
          }
        }
      }
    }
  }
}
