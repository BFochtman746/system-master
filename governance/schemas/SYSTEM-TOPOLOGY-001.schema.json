{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SYSTEM-MASTER/SYSTEM-TOPOLOGY-001",
  "title": "System Topology",
  "description": "Which systems exist and how they relate. Completion is a declared fact, never inferred.",
  "type": "object",
  "required": [
    "topology_id",
    "effective_date",
    "standing",
    "product_root",
    "canonical_internal_systems"
  ],
  "properties": {
    "topology_id": {
      "type": "string",
      "pattern": "^SYSTEM-TOPOLOGY-\\d{3}$"
    },
    "effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "standing": {
      "type": "string",
      "minLength": 1
    },
    "product_root": {
      "type": "object",
      "required": [
        "product_id",
        "classification",
        "job"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "owns_product_architecture": {
          "type": "boolean"
        }
      }
    },
    "canonical_internal_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "system_id",
          "classification",
          "parent_id",
          "completion"
        ],
        "properties": {
          "system_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "canonical_name": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "control_ref": {
            "type": "string"
          },
          "completion": {
            "type": "string",
            "enum": [
              "COMPLETE",
              "INCOMPLETE",
              "RETIRED"
            ]
          }
        }
      }
    }
  }
}
