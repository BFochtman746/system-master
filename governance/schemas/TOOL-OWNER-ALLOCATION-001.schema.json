{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SYSTEM-MASTER/TOOL-OWNER-ALLOCATION-001",
  "title": "Tool Owner Allocation",
  "description": "Who owns which module. Lane briefs and the closure matrix both resolve ownership here, so a malformed entry silently unscopes a lane.",
  "type": "object",
  "required": [
    "allocation_id",
    "effective_date",
    "standing",
    "module_ownership"
  ],
  "properties": {
    "allocation_id": {
      "type": "string",
      "pattern": "^SYSTEM-MASTER-TOOL-OWNER-ALLOCATION-\\d{3}$"
    },
    "effective_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "standing": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.][A-Za-z0-9._/-]*\\.(json|md|js|ya?ml)$"
    },
    "module_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_key",
          "owner_path"
        ],
        "properties": {
          "module_key": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "owner_path": {
            "type": "string",
            "pattern": "^SYSTEM_MASTER(/[A-Z0-9_]+)*$"
          }
        }
      }
    },
    "explicitly_deferred_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_key",
          "disposition"
        ],
        "properties": {
          "module_key": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "disposition": {
            "type": "string",
            "pattern": "^EXPLICITLY_OUT_OF_SCOPE_WITH_AUTHORITY"
          }
        }
      }
    },
    "boundary_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
