{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "REPAIR-INBOX-SCHEMA-001",
  "title": "System Master owner repair inbox",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner_system_id", "owner_path", "inbox_version", "active_transactions", "transaction_history"],
  "properties": {
    "owner_system_id": {"enum": ["CORE", "LEARNING", "BOOK", "DOCUMENTS", "SPREADSHEET_DATA", "MEDIA", "CONNECTED_ACTIONS", "RESEARCH_KNOWLEDGE", "PROGRAMMING", "PROSE"]},
    "owner_path": {"type": "string", "minLength": 1},
    "inbox_version": {"type": "integer", "minimum": 1},
    "active_transactions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transaction"}
    },
    "transaction_history": {
      "type": "array",
      "items": {"$ref": "#/$defs/history"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "transaction": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "transaction_id", "state", "owner_path", "receipt_id", "qualification_id", "workstream_id",
        "failed_subject_sha", "classification", "repair_attempt", "max_repair_attempts", "created_at"
      ],
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "REPAIR_REQUEST_READY", "CLAIMED", "CANDIDATE_PREQUAL_REQUIRED", "A01_REQUEUE_READY",
            "OWNER_ACTION_REQUIRED", "OWNER_AUTHORITY_REQUIRED", "WAIT_FOR_PREDECESSOR",
            "REPLAN_ADMISSION", "RETRY_REQUEST_READY"
          ]
        },
        "owner_path": {"type": "string", "minLength": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "qualification_id": {"type": "string", "minLength": 1},
        "workstream_id": {"type": "string", "minLength": 1},
        "failed_subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "classification": {"type": "string", "minLength": 1},
        "repair_attempt": {"type": "integer", "minimum": 0},
        "max_repair_attempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "created_at": {"type": "string", "minLength": 1},
        "evidence_pointer": {"type": ["string", "null"]},
        "replacement_subject_sha": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
        "prequalification_evidence_pointer": {"type": ["string", "null"]},
        "repair_branch": {"type": ["string", "null"]}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": true,
      "required": ["transaction_id", "final_state", "closed_at"],
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1},
        "final_state": {"type": "string", "minLength": 1},
        "closed_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
