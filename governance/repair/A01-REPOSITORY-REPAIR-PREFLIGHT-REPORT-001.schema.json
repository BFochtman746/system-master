{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SYSTEM-MASTER/A01-REPOSITORY-REPAIR-PREFLIGHT-REPORT-001",
  "title": "A-01 Repository Repair Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "read_only",
    "repository_commit_sha",
    "repository_tree_sha",
    "tree_entry_count",
    "tree_enumeration_complete",
    "authority_id",
    "current_authority_blob_sha",
    "selected_controls",
    "owner_heads",
    "active_claims",
    "live_control_documents_checked",
    "executable_controls_checked",
    "findings",
    "standing",
    "captured_at",
    "invalidated_by"
  ],
  "properties": {
    "report_version": {"const": 1},
    "read_only": {"const": true},
    "repository_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_entry_count": {"type": "integer", "minimum": 1},
    "tree_enumeration_complete": {"const": true},
    "authority_id": {"type": "string", "minLength": 1},
    "current_authority_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selected_controls": {"type": "object"},
    "owner_heads": {"type": "array"},
    "active_claims": {"type": "array"},
    "live_control_documents_checked": {"type": "array"},
    "executable_controls_checked": {"type": "array"},
    "findings": {"type": "array"},
    "standing": {"enum": ["SAFE_TO_REPAIR", "REPAIR_BLOCKED_BY_STALE_CONTROL_TRUTH"]},
    "captured_at": {"type": "string", "minLength": 1},
    "invalidated_by": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
