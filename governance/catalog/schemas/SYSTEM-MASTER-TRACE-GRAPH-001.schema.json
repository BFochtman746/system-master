{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"system-master://knowledge-recovery/trace-graph/v1",
  "title":"System Master Recovered Trace Graph",
  "type":"object",
  "additionalProperties":false,
  "required":["graph_id","schema_version","candidate_system_id","architecture_authority","nodes","edges"],
  "properties":{
    "graph_id":{"type":"string","minLength":1},
    "schema_version":{"const":1},
    "candidate_system_id":{"type":"string","minLength":1},
    "architecture_authority":{"const":false},
    "nodes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["node_id","node_kind"],"properties":{"node_id":{"type":"string","minLength":1},"node_kind":{"enum":["SOURCE","ASSET","SYSTEM_CANDIDATE","ACTIVE_SYSTEM","RETIRED_SYSTEM","QUALIFICATION"]},"label":{"type":"string"}}}},
    "edges":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["edge_id","from","to","relation","source_ids"],"properties":{"edge_id":{"type":"string","minLength":1},"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"relation":{"enum":["DERIVED_FROM","IMPLEMENTS","SATISFIES","QUALIFIED_BY","DEPENDS_ON","SUPERSEDES","RETIRED_INTO","DUPLICATES","CONFLICTS_WITH","HAS_AFFINITY_TO"]},"source_ids":{"type":"array","minItems":1,"items":{"type":"string"}}}}}
  }
}
