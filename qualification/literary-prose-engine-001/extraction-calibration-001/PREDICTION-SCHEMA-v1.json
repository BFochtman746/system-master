{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-master.local/literary/extraction-calibration/prediction-v1.json",
  "title": "Literary Narrative Extraction Prediction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "task", "predictions"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "task": {"enum": ["ANCHOR_LOCALIZATION", "ENTITY_IDENTITY_COREFERENCE", "EVENT_IDENTITY", "STORY_VS_DISCOURSE_TIME", "CAUSAL_GOAL_RELATIONS", "EPISTEMIC_FOCALIZATION", "NARRATIVE_FUNCTION", "SETUP_PAYOFF_OPEN_QUESTION", "ARC_ORCHESTRATION"]},
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "confidence", "status"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
          "status": {"enum": ["ASSERTED", "ALTERNATIVE", "UNRESOLVED", "ABSTAIN"]}
        }
      }
    },
    "predicted_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "span"],
        "properties": {
          "anchor_id": {"type": "string"},
          "span": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}
        }
      }
    }
  }
}
