    "AUTHOR_DECISION_REQUIRED": ["ACCEPTED_INTO_CANONICAL_MANUSCRIPT", "RETAINED_ORIGINAL", "DEFERRED", "INVALIDATED_BY_UPSTREAM_CHANGE"],
    "ACCEPTED_INTO_CANONICAL_MANUSCRIPT": ["DIAGNOSTIC_REVIEW", "INVALIDATED_BY_UPSTREAM_CHANGE"],
