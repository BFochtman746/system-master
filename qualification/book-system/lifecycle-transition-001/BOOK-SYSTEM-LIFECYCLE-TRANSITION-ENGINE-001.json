    "actor_class": "PARENT_SYSTEM",
    "scopes": ["PROJECT", "UNIT"],
    "rule": "Only PARENT_SYSTEM may submit a transition request. Services may only return evidence/proposals through the qualified Service Interface Registry; they cannot directly call this engine."
