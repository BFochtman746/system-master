  "invalidation": {
    "dependency_edge_required": ["edge_id", "upstream_ref", "downstream_ref", "dependency_class"],
    "dependency_classes": ["PLAN", "CANON", "STORY_BIBLE", "MANUSCRIPT", "RESEARCH", "ARC", "SETUP_PAYOFF", "OTHER"],
    "propagation": "When an accepted upstream canonical change invalidates a dependency edge, every reachable downstream unit that is not already INVALIDATED_BY_UPSTREAM_CHANGE is atomically transitioned to INVALIDATED_BY_UPSTREAM_CHANGE, preserving invalidated_from_status and all cause refs.",
    "service_response_rule": "Any pending service response bound to a parent state version/digest older than the accepted upstream change is stale until explicitly revalidated. Stale provider SUCCESS cannot satisfy a transition gate.",
    "restoration_rule": "An invalidated unit may restore only its recorded invalidated_from_status after INVALIDATED_UNIT_REVALIDATED evidence is registered against the current parent state."
  },
  "author_boundary": {
    "rule": "A gate requiring author authority passes only when the referenced AUTHOR_DECISION object exists in the exact parent state, has status APPROVED, has the required decision_type, and has an affirmative author_choice applicable to the target transition.",
    "no_inference": true
  },
  "service_boundary": {
    "rule": "Evidence or proposals produced by Prose, Book Evaluator, research, or artifact services count only after the parent has registered them through operations allowed by BOOK-SYSTEM-SERVICE-INTERFACE-REGISTRY-001 and they remain current for the exact parent projection.",
    "service_success_is_not_transition_authority": true
  },
  "idempotency": {
    "same_idempotency_key_same_normalized_request": "RETURN_EXISTING_RECEIPT_NO_NEW_COMMIT",
    "same_idempotency_key_different_normalized_request": "REJECT_IDEMPOTENCY_KEY_CONFLICT",
    "same_request_id_different_idempotency_key": "REJECT_REQUEST_ID_CONFLICT"
  },
  "transactionality": {
    "precondition_order": [
      "validate request schema and actor",
      "validate exact parent state version/digest",
      "validate exact ledger version/digest",
      "resolve current status",
      "validate legal transition",
      "validate evidence and author gates against current parent state",
      "validate service-derived evidence freshness",
      "calculate invalidation closure",
      "apply all changes to copies only",
      "validate post-state and post-ledger",
      "commit parent state and ledger together",
      "emit transition receipt"
    ],
    "failure_rule": "Any failed step commits neither parent state nor lifecycle ledger and emits no successful transition receipt.",
    "rollback_rule": "Every receipt records the exact pre-parent and pre-ledger identities required to restore the prior committed pair."
  },
  "qualification_objective": "Prove project and unit legal transition enforcement, hard-gate evidence and author boundaries, exact parent/ledger concurrency checks, service-response staleness, deterministic defer/resume and invalidation/restore behavior, transitive invalidation, atomic rollback, duplicate replay, request/idempotency conflicts, and provider inability to invoke transitions directly.",
