      "status",
      "status_version",
      "last_transition_receipt_ref",
      "deferred_from_status",
      "invalidated_from_status",
      "invalidation_causes"
    ],
    "unit_types": ["PART", "CHAPTER", "SCENE", "SECTION", "PASSAGE", "OTHER"],
