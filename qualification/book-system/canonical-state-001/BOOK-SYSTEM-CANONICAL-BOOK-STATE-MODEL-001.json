{
  "model_id": "BOOK-SYSTEM-CANONICAL-BOOK-STATE-MODEL-001",
  "version": 1,
  "effective_date": "2026-09-09",
  "standing": "CANONICAL__EXECUTABLE_PARENT_STATE_MODEL__QUALIFICATION_PENDING",
  "owner": "BOOK SYSTEM",
  "depends_on": [
    "BOOK-SYSTEM-AUTHORING-LIFECYCLE-CONTRACT-001",
    "BOOK-SYSTEM-BOOK-INTELLIGENCE-UNIFICATION-BINDING-001",
    "BOOK-SYSTEM-PARENT-INTEGRATION-BOUNDARY-001"
  ],
  "aggregate": {
    "type": "BOOK_SYSTEM_CANONICAL_STATE",
    "required": [
      "schema_version",
      "state_version",
      "book_project",
      "governing_briefs",
      "canon_manifests",
      "story_bibles",
      "book_plans",
      "manuscripts",
      "research_evidence_links",
      "author_decisions",
      "integration_proposals",
      "export_releases",
      "active"
