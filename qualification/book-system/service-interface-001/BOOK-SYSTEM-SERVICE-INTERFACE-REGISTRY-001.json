  ],
  "retry_and_replay_policy": {
    "idempotent_operation": {
      "same_idempotency_key_same_normalized_request": "RETURN_SAME_LOGICAL_RESULT_OR_EXPLICIT_REPLAY_REFERENCE",
      "same_idempotency_key_different_normalized_request": "REJECT_IDEMPOTENCY_KEY_CONFLICT"
    },
    "non_idempotent_operation": {
      "automatic_retry_after_unknown_outcome": false,
      "required_behavior": "RECONCILE_BY_REQUEST_ID_BEFORE_NEW_GENERATION"
    },
    "stale_parent_projection": "REJECT_OR_REQUIRE_EXPLICIT_PARENT_REVALIDATION",
    "transient_error": "RETRY_ONLY_IF_OPERATION_POLICY_AND_CUSTODY_BOUNDARY_ALLOW",
    "permanent_error": "DO_NOT_RETRY_WITHOUT_CHANGED_INPUT_OR_AUTHORITY"
  },
  "parent_admission_handoff": {
    "allowed_parent_state_operations": [
      "REGISTER_RESEARCH_EVIDENCE_LINK",
      "REGISTER_AUTHOR_DECISION",
      "REGISTER_INTEGRATION_PROPOSAL",
      "REGISTER_EXPORT_RELEASE"
    ],
    "forbidden_direct_operations_from_service": [
      "ADVANCE_PROJECT_STATUS",
      "SET_ACTIVE_GOVERNING_BRIEF",
      "SET_ACTIVE_CANON_MANIFEST",
      "SET_ACTIVE_STORY_BIBLE",
      "SET_ACTIVE_BOOK_PLAN",
      "SET_ACTIVE_CANONICAL_MANUSCRIPT"
    ],
    "rule": "Service response is translated by a parent-owned integration/admission layer into a permitted parent mutation envelope. The provider cannot submit or sign a parent canonical-pointer mutation."
  },
  "compatibility_and_invalidation": {
    "unknown_registry_version": "FAIL_CLOSED",
    "unknown_request_schema_version": "FAIL_CLOSED",
    "unknown_response_schema_version": "FAIL_CLOSED",
    "operation_removed_or_semantics_changed": "NEW_REGISTRY_VERSION_REQUIRED",
    "parent_state_advanced_after_projection": "RESPONSE_STALE_UNTIL_REVALIDATED",
    "provider_subject_changed": "NEW_PROVIDER_SUBJECT_IDENTITY_REQUIRED",
    "rights_or_privacy_boundary_changed": "INVALIDATE_AFFECTED_PENDING_REQUESTS_AND_RESPONSES"
  },
  "qualification_objective": "Adversarially prove service/operation/schema validation, provider-class binding, minimum projection enforcement, exact parent projection identity, canonical-write denial, stale response rejection, idempotency conflict/replay behavior, non-idempotent retry safety, abstention/error preservation and parent-admission handoff boundaries.",
  "exact_next_objective_after_pass": "BOOK-SYSTEM-LIFECYCLE-TRANSITION-ENGINE-001",
  "qualification_effect": "NONE until an exact subject SHA passes the registered A-01 qualification for this registry."
