{
  "registry_id": "BOOK-SYSTEM-SERVICE-INTERFACE-REGISTRY-001",
  "registry_version": 1,
  "effective_date": "2026-09-09",
  "standing": "CANONICAL__PARENT_SERVICE_REGISTRY__QUALIFICATION_PENDING",
  "owner": "BOOK SYSTEM",
  "depends_on": [
    "BOOK-SYSTEM-AUTHORING-LIFECYCLE-CONTRACT-001",
    "BOOK-SYSTEM-PARENT-INTEGRATION-BOUNDARY-001",
    "BOOK-SYSTEM-BOOK-INTELLIGENCE-UNIFICATION-BINDING-001",
    "BOOK-SYSTEM-CANONICAL-BOOK-STATE-MODEL-001"
  ],
  "governing_law": [
    "Book System owns canonical book state and canonical mutation authority.",
    "A service receives only the minimum bounded projection required for its registered operation.",
    "A service response is evidence, an artifact, an abstention, or an integration proposal; it is never a direct canonical write.",
    "Exact subject/version/digest identity must survive request -> provider -> response -> parent admission.",
    "Unknown service IDs, operation IDs, schema versions, provider classes or response classes fail closed.",
    "Retries and replay must not create duplicate parent proposals or duplicate durable artifacts when an operation is declared idempotent.",
    "Human, author, publication, rights and promotion authority cannot be inferred from provider success."
  ],
  "common_request_envelope": {
    "schema_version": 1,
    "required": [
      "request_id",
      "correlation_id",
      "idempotency_key",
      "service_id",
      "operation_id",
      "schema_version",
      "book_project_id",
      "book_id",
      "parent_state_version",
      "parent_state_digest",
      "target_refs",
      "projection",
      "authority_context"
    ],
    "authority_context_required": [
      "requesting_authority",
      "canonical_write_allowed",
      "author_decision_required_if_returned",
      "rights_boundary",
      "privacy_boundary"
    ],
    "rules": [
      "canonical_write_allowed must be false for every external child/lane/service request.",
      "parent_state_digest is sha256 over the exact parent state used to construct the projection.",
      "request_id identifies one logical request; idempotency_key identifies replay equivalence.",
      "target_refs must resolve within the referenced parent state or an explicitly admitted artifact set.",
      "projection must omit data forbidden by the operation's custody policy."
    ]
  },
  "common_response_envelope": {
    "schema_version": 1,
    "required": [
      "response_id",
      "request_id",
      "correlation_id",
      "idempotency_key",
      "service_id",
      "operation_id",
      "schema_version",
      "provider_class",
      "provider_subject",
      "parent_projection_identity",
      "result_class",
      "evidence_refs",
      "proposal_refs",
      "artifact_refs",
      "abstentions",
      "warnings",
      "requested_parent_action"
    ],
    "provider_subject_required": ["subject_sha", "implementation_or_artifact_id"],
    "parent_projection_identity_required": ["parent_state_version", "parent_state_digest"],
    "result_classes": ["SUCCESS", "PARTIAL", "ABSTAIN", "REJECTED", "ERROR"],
    "requested_parent_actions": [
      "NONE",
      "REGISTER_EVIDENCE",
      "REGISTER_INTEGRATION_PROPOSAL",
      "QUEUE_AUTHOR_DECISION",
      "REGISTER_ARTIFACT",
      "REVIEW_REQUIRED"
    ],
    "rules": [
      "SUCCESS is not parent admission.",
      "PARTIAL and ABSTAIN are first-class results and must not be rewritten as SUCCESS.",
      "ERROR must preserve an error code and may be retryable only under the registered operation retry policy.",
      "A response for a stale parent projection cannot be admitted without explicit revalidation against current parent state.",
      "proposal_refs may enter parent state only through REGISTER_INTEGRATION_PROPOSAL or a later explicit parent-owned admission runtime.",
      "artifact_refs do not imply canonical manuscript selection, publication, or delivery authority."
    ]
  },
