{
  "contract_id": "BOOK-SYSTEM-EXPORT-FREEZE-001",
  "contract_version": 1,
  "effective_date": "2026-09-09",
  "owner_path": "SYSTEM_MASTER/BOOK",
  "standing": "CANONICAL_PARENT_EXPORT_FREEZE_CONTRACT__IMPLEMENTATION_BLOCKED_ON_LIFECYCLE_CURRENT_PARENT_COMPATIBILITY_QUALIFICATION",
  "depends_on": [
    "BOOK-SYSTEM-CANONICAL-BOOK-STATE-MODEL-001",
    "BOOK-SYSTEM-LIFECYCLE-TRANSITION-ENGINE-001",
    "BOOK-SYSTEM-SERVICE-INTERFACE-REGISTRY-002",
    "BOOK-SYSTEM-VERSION-AND-ROLLBACK-001",
    "BOOK-SYSTEM-AUTHOR-DECISION-QUEUE-001",
    "BOOK-SYSTEM-DOCUMENT-SYSTEM-EXPORT-OWNERSHIP-BOUNDARY-001",
    "BOOK-SYSTEM-PUBLICATION-EXPORT-STANDARDS-PROFILE-001",
    "BOOK-SYSTEM-PROVENANCE-INTEROPERABILITY-PROJECTION-001",
    "BOOK-SYSTEM-EXPORT-FREEZE-FORENSIC-MAP-001",
    "BOOK-SYSTEM-LIFECYCLE-PARENT-IDENTITY-COMPATIBILITY-FINDING-001",
    "BOOK-SYSTEM-LIFECYCLE-CURRENT-PARENT-COMPATIBILITY-ADAPTER-001"
  ],
  "purpose": "Create one immutable parent-owned frozen export artifact record only after exact source, artifact, profile, proof, rights/privacy and provenance prerequisites are current, without generating bytes, changing lifecycle state or authorizing publication.",
  "compatibility_precondition": {
    "required_before_runtime_implementation": "BOOK-SYSTEM-LIFECYCLE-CURRENT-PARENT-COMPATIBILITY-ADAPTER-001 exact-SHA PASS",
    "reason": "Current sealed-array parent state cannot safely round-trip through Lifecycle v1 without a qualified representation and parent-digest identity bridge.",
    "no_bypass": "Export Freeze runtime may not contain a private hidden lifecycle adapter."
  },
  "authority": {
    "request_actor": "PARENT_SYSTEM",
    "canonical_append_allowed": "ONE_EXPORT_RELEASE_ONLY",
    "lifecycle_transition_allowed": false,
    "canonical_manuscript_mutation_allowed": false,
    "document_generation_allowed": false,
    "provider_freeze_authority_allowed": false,
    "publication_authority_allowed": false,
    "author_choice_synthesis_allowed": false
  },
  "release_granularity": {
    "unit": "ONE_FORMAT_ARTIFACT_PER_EXPORT_RELEASE",
    "multi_format_grouping": "OPTIONAL_ADDITIVE_RELEASE_GROUP_REF",
    "rule": "Every distinct frozen byte artifact receives its own release_id, format and digest."
  },
  "freeze_request": {
    "required": [
      "freeze_request_id",
      "idempotency_key",
      "actor_class",
      "expected_parent_state_version",
      "expected_parent_state_digest",
      "release_id",
      "release_group_ref",
      "canonical_manuscript_identity",
      "artifact_evidence",
      "target_medium_evidence",
      "rights_privacy_evidence",
      "provenance_evidence",
      "parent_admission_refs",
      "author_decision_refs",
      "created_at"
    ],
    "canonical_manuscript_identity_required": ["manuscript_id", "version_id", "artifact_digest"],
    "artifact_evidence_required": ["artifact_ref", "artifact_digest", "artifact_currentness", "format_identity", "source_manuscript_id", "source_version_id", "source_digest", "generator_or_toolchain_identity"],
    "target_medium_evidence_required": ["target_medium_profile_id", "target_medium_profile_version", "technical_state", "format_validation_result", "source_to_render_integrity_result", "accessibility_result", "proof_result", "correction_ledger_ref", "correction_ledger_state", "rendered_candidate_digest"],
    "rights_privacy_evidence_required": ["rights_state", "privacy_state", "evidence_ref"],
    "provenance_evidence_required": ["currentness_state", "validation_result", "projection_ref", "bound_artifact_digest"]
  },
  "freeze_preconditions": [
    "Current parent is valid sealed-array state and project status is FINALIZATION.",
    "Actor is PARENT_SYSTEM and expected parent version/digest exactly match.",
    "release_id is new unless this is an exact idempotent replay.",
    "Requested manuscript exactly matches active canonical manuscript id/version/digest.",
    "Artifact source identity exactly matches the active canonical manuscript.",
    "artifact_currentness=CURRENT_FOR_BOUND_SOURCE.",
    "artifact_digest equals rendered_candidate_digest and both are lowercase sha256.",
    "technical_state=POST_LAYOUT_PROOF_COMPLETE.",
    "format_validation_result=PASS, source_to_render_integrity_result=PASS and proof_result=PASS.",
    "accessibility_result is PASS or NOT_APPLICABLE_WITH_RATIONALE according to the selected profile.",
    "correction_ledger_state=CLOSED_CURRENT for the exact final artifact digest.",
    "rights_state=CURRENT_AUTHORIZED and privacy_state=CURRENT_ALLOWED.",
    "provenance currentness is NONE or CURRENT_FOR_BOUND_SOURCE_AND_ARTIFACT; when present its bound digest exactly matches and validation is PASS.",
    "Required parent admission refs are current for the exact source/artifact identity.",
    "Configured author-decision requirements, if any, are satisfied by exact current approved decisions; no decision is fabricated for freeze.",
    "No historical release is mutated or rebound."
  ],
  "freeze_transaction": {
    "precondition_order": [
      "schema/actor",
      "idempotent replay/conflict classification",
      "parent CAS",
      "FINALIZATION status",
      "active manuscript identity",
      "artifact/source/profile identity",
      "technical proof/currentness",
      "rights/privacy/provenance",
      "admission/author refs",
      "append additive EXPORT_RELEASE",
      "seal state_version+1 with status unchanged",
      "validate append-only preservation",
      "emit deterministic release receipt"
    ],
    "failure_rule": "Any failure commits nothing.",
    "same_transaction_forbidden_effects": ["ADVANCE_PROJECT_STATUS", "SET_ACTIVE_CANONICAL_MANUSCRIPT", "REGISTER_INTEGRATION_PROPOSAL", "AUTHOR_DECISION_SYNTHESIS", "PUBLICATION_AUTHORIZATION", "DOCUMENT_ARTIFACT_GENERATION_OR_MUTATION"]
  },
  "export_release_projection": {
    "base_required_fields": ["release_id", "frozen_version_id", "format", "digest", "approval_state", "publication_authority_state"],
    "required_additive_fields": [
      "release_group_ref", "evidence_type", "canonical_manuscript_id", "canonical_manuscript_version_id", "canonical_manuscript_digest", "artifact_ref", "artifact_currentness", "target_medium_profile_id", "target_medium_profile_version", "technical_state", "format_validation_result", "source_to_render_integrity_result", "accessibility_result", "proof_result", "correction_ledger_ref", "rights_evidence_ref", "privacy_evidence_ref", "provenance_projection_ref", "provenance_currentness_state", "parent_admission_refs", "author_decision_refs", "freeze_request_id", "freeze_request_fingerprint", "pre_parent_state_version", "pre_parent_state_digest", "frozen_at"
    ],
    "fixed_values_at_freeze": {
      "approval_state": "FROZEN",
      "publication_authority_state": "NOT_AUTHORIZED",
      "evidence_type": "EXPORT_FREEZE_READY",
      "artifact_currentness": "CURRENT_FOR_BOUND_SOURCE",
      "technical_state": "POST_LAYOUT_PROOF_COMPLETE"
    },
    "rule": "The release becomes evidence for a later separate Lifecycle transition only through the qualified current-parent compatibility adapter."
  },
  "release_receipt": {
    "required": ["release_receipt_id", "freeze_request_id", "idempotency_key", "release_id", "pre_parent_state_version", "pre_parent_state_digest", "post_parent_state_version", "post_parent_state_digest", "canonical_manuscript_identity", "artifact_ref", "artifact_digest", "target_medium_profile_id", "target_medium_profile_version", "evidence_bundle_digest", "publication_authority_state", "lifecycle_status_before", "lifecycle_status_after", "lifecycle_handoff_evidence_ref"],
    "fixed_lifecycle_rule": "lifecycle_status_before and lifecycle_status_after are FINALIZATION."
  },
  "post_freeze_lifecycle_handoff": {
    "authority": "BOOK-SYSTEM-LIFECYCLE-TRANSITION-ENGINE-001 through BOOK-SYSTEM-LIFECYCLE-CURRENT-PARENT-COMPATIBILITY-ADAPTER-001",
    "transition": "FINALIZATION->EXPORT_FROZEN",
    "required_evidence_ref": "new release_id carrying EXPORT_FREEZE_READY",
    "rule": "Release successor must be committed and recorded by Version/Rollback before the separate lifecycle request."
  },
  "version_rollback_handoff": {
    "authority_kind_for_release_successor": "EXPORT_RELEASE",
    "authority_receipt": "release_receipt",
    "rule": "Version/Rollback records the already-committed release successor; it neither creates the release nor transitions lifecycle."
  },
  "invalidation_and_refreeze": {
    "immutable_release_records": true,
    "invalidating_conditions": ["manuscript changes", "artifact bytes change", "target profile changes", "technical proof becomes failed/stale", "proof correction changes bytes", "rights/privacy changes", "required provenance becomes stale/withdrawn/invalid"],
    "when_project_status_is_EXPORT_FROZEN": "Use the qualified compatibility adapter plus Lifecycle v1 for EXPORT_FROZEN->FINALIZATION with EXPORT_FREEZE_INVALIDATED evidence, preserve old release, then create a new release_id after fresh technical evidence.",
    "silent_rebind_forbidden": true
  },
  "idempotency": {
    "same_idempotency_key_same_normalized_request": "RETURN_EXISTING_LOGICAL_RECEIPT_NO_NEW_RELEASE",
    "same_idempotency_key_different_request": "REJECT_IDEMPOTENCY_KEY_CONFLICT",
    "same_freeze_request_id_different_idempotency_key": "REJECT_REQUEST_ID_CONFLICT",
    "same_release_id_different_request": "REJECT_RELEASE_ID_CONFLICT"
  },
  "explicit_non_goals": ["document generation", "generic file validation", "manuscript mutation", "direct lifecycle transition", "publication authorization", "author-decision synthesis", "multi-format digest collapsing", "replacement of qualified foundational engines"],
  "qualification_objective": "After compatibility qualification, prove exact parent/source/artifact/profile CAS, proof/currentness gates, additive v1-compatible release creation, immutable/idempotent history, zero lifecycle/publication/document authority and deterministic Version/Rollback handoff.",
  "exact_next_objective_after_contract": "BOOK-SYSTEM-LIFECYCLE-CURRENT-PARENT-COMPATIBILITY-ADAPTER-001",
  "qualification_effect": "NONE__EXPORT_FREEZE_RUNTIME_IMPLEMENTATION_PAUSED_UNTIL_COMPATIBILITY_ADAPTER_EXACT_SHA_PASS"
}
