{
  "registry_id": "BOOK-SYSTEM-SERVICE-INTERFACE-REGISTRY-002",
  "registry_version": 2,
  "effective_date": "2026-09-09",
  "standing": "CANONICAL_SUCCESSOR_CONTRACT__QUALIFICATION_PENDING",
  "owner_path": "SYSTEM_MASTER/BOOK",
  "supersedes_for_future_runtime_integration": "BOOK-SYSTEM-SERVICE-INTERFACE-REGISTRY-001",
  "v1_preservation_rule": "Registry V1 and its exact-SHA A-01 PASS remain immutable historical evidence. V1 envelopes are not silently upgraded to V2 and V1 PASS never qualifies V2.",
  "depends_on": [
    "BOOK-SYSTEM-CANONICAL-BOOK-STATE-MODEL-001",
    "BOOK-SYSTEM-PARENT-INTEGRATION-BOUNDARY-001",
    "BOOK-SYSTEM-BOOK-INTELLIGENCE-UNIFICATION-BINDING-001",
    "BOOK-SYSTEM-RESEARCH-VERIFIED-AUTHORING-LIFECYCLE-AMENDMENT-001",
    "BOOK-SYSTEM-DOCUMENT-SYSTEM-EXPORT-OWNERSHIP-BOUNDARY-001",
    "BOOK-SYSTEM-PUBLICATION-EXPORT-STANDARDS-PROFILE-001",
    "BOOK-SYSTEM-PROVENANCE-INTEROPERABILITY-PROJECTION-001",
    "BOOK-SYSTEM-INTEGRATION-PROPOSAL-RUNTIME-002"
  ],
  "governing_law": [
    "Book System owns canonical book state, admission, lifecycle routing, export freeze and publication authority.",
    "Providers receive only minimum bounded projections required by a registered operation.",
    "Every provider response is evidence, artifact output, abstention, error, or proposal input; never a direct canonical write.",
    "Exact parent, source-object, artifact and provider identities survive request through response through parent admission.",
    "Technical artifact generation, validation, proof or provenance validation never implies export freeze or publication authorization.",
    "Unknown service IDs, operation IDs, provider classes, schema versions, technical states or response classes fail closed.",
    "No Book-owned PDF, DOCX, EPUB, print, accessibility, conversion, credential-embedding or generic render engine is authorized by this registry.",
    "The planning label Document System is not promoted into current System Master topology by this contract; reusable document mechanics remain external or future-allocated implementation behind HEADLESS_ARTIFACT_SERVICE until topology explicitly assigns an owner."
  ],
  "schema_compatibility": {
    "v2_request_schema_version": 2,
    "v2_response_schema_version": 2,
    "v1_envelopes_accepted_by_v2_registry": false,
    "v1_callers": "Remain bound to Registry V1 until an explicitly qualified adapter or V2 caller is used.",
    "unknown_or_future_schema_version": "FAIL_CLOSED",
    "automatic_cross_version_field_inference": false,
    "reason": "V2 adds exact source/artifact currentness, editorial context, target-medium proof and provenance semantics that cannot be inferred safely from V1 envelopes."
  },
  "common_request_envelope": {
    "schema_version": 2,
    "required": [
      "request_id",
      "correlation_id",
      "idempotency_key",
      "service_id",
      "operation_id",
      "schema_version",
      "book_project_id",
      "book_id",
      "parent_state_version",
      "parent_state_digest",
      "target_refs",
      "source_identity_refs",
      "projection",
      "authority_context"
    ],
    "source_identity_ref_required": ["object_id", "object_version", "object_digest"],
    "authority_context_required": [
      "requesting_authority",
      "canonical_write_allowed",
      "lifecycle_transition_allowed",
      "export_freeze_allowed",
      "publication_authorized",
      "author_decision_required_if_returned",
      "rights_boundary",
      "privacy_boundary"
    ],
    "rules": [
      "canonical_write_allowed, lifecycle_transition_allowed and export_freeze_allowed must be false for every provider request.",
      "publication_authorized must be false for every provider request; publication authorization is not delegated to service providers.",
      "parent_state_digest and source object digests are lowercase sha256 hex over exact immutable identities.",
      "target_refs and source_identity_refs must resolve to the bound parent state or explicitly admitted immutable artifacts.",
      "projection must omit data forbidden by rights/privacy/custody policy."
    ]
  },
  "common_response_envelope": {
    "schema_version": 2,
    "required": [
      "response_id",
      "request_id",
      "correlation_id",
      "idempotency_key",
      "service_id",
      "operation_id",
      "schema_version",
      "provider_class",
      "provider_subject",
      "parent_projection_identity",
      "source_identity_refs",
      "result_class",
      "evidence_refs",
      "proposal_refs",
      "artifact_evidence",
      "editorial_stage_evidence",
      "target_medium_evidence",
      "provenance_evidence",
      "abstentions",
      "warnings",
      "requested_parent_action"
    ],
    "provider_subject_required": ["subject_sha", "implementation_or_artifact_id"],
    "parent_projection_identity_required": ["parent_state_version", "parent_state_digest"],
    "result_classes": ["SUCCESS", "PARTIAL", "ABSTAIN", "REJECTED", "ERROR"],
    "requested_parent_actions": [
      "NONE",
      "REGISTER_EVIDENCE",
      "REGISTER_INTEGRATION_PROPOSAL",
      "QUEUE_AUTHOR_DECISION",
      "REGISTER_ARTIFACT",
      "REVIEW_REQUIRED"
    ],
    "provider_technical_states_allowed": ["NONE", "EXPORT_GENERATED", "FORMAT_VALIDATED", "POST_LAYOUT_PROOF_COMPLETE"],
    "provider_technical_states_forbidden": ["EXPORT_FROZEN", "PUBLICATION_AUTHORIZED"],
    "rules": [
      "SUCCESS is not parent admission.",
      "PARTIAL, ABSTAIN, REJECTED and ERROR remain distinct result classes.",
      "ABSTAIN requires an explicit reason and ERROR requires an explicit code in evidence/warnings according to the operation contract.",
      "Stale parent/source/artifact/provenance identity cannot advance parent admission without explicit revalidation.",
      "A provider may report technical evidence but may not report or infer EXPORT_FROZEN or PUBLICATION_AUTHORIZED.",
      "External provenance is evidence-only and cannot establish authorship, approval, canonical state or publication authority beyond admitted internal evidence."
    ]
  },
  "editorial_stage_context": {
    "recognized_stages": ["STRUCTURAL_EDIT_REVIEW", "STYLISTIC_OR_LINE_EDIT_REVIEW", "COPY_EDIT_REVIEW", "POST_LAYOUT_PROOFREAD_REVIEW"],
    "stage_evidence_fields": [
      "stage_token",
      "applicability",
      "not_applicable_rationale",
      "entry_evidence_refs",
      "exit_evidence_refs",
      "narrative_consistency_regression_refs",
      "prior_stage_regression_refs",
      "upstream_defect_routing_refs",
      "author_decision_refs"
    ],
    "provider_stage_completion_authority": false,
    "rules": [
      "Stage-scoped providers may return evidence for a recognized stage but cannot advance Book lifecycle state.",
      "NOT_APPLICABLE requires a rationale and cannot hide unresolved required evidence.",
      "Later-stage evidence cannot silently widen authority to perform upstream structural or line editing."
    ]
  },
  "artifact_evidence_contract": {
    "required_when_artifact_returned": [
      "artifact_ref",
      "artifact_digest",
      "artifact_currentness",
      "format_identity",
      "target_medium_profile_id",
      "target_medium_profile_version",
      "generator_or_toolchain_identity"
    ],
    "artifact_currentness_states": ["CURRENT_FOR_BOUND_SOURCE", "STALE_SOURCE", "STALE_PROFILE", "SUPERSEDED_ARTIFACT", "VALIDATION_FAILED"],
    "rules": [
      "Any changed artifact bytes require a new artifact digest.",
      "An artifact bound to a superseded source or target profile is not current for admission/proof.",
      "Artifact identity never implies canonical manuscript selection or publication authority."
    ]
  },
  "target_medium_evidence_contract": {
    "required_when_target_medium_operation": [
      "technical_state",
      "format_validation_result",
      "source_to_render_integrity_result",
      "accessibility_result",
      "proof_result",
      "correction_ledger_ref",
      "rendered_candidate_digest"
    ],
    "technical_state_order": ["EXPORT_GENERATED", "FORMAT_VALIDATED", "POST_LAYOUT_PROOF_COMPLETE"],
    "rules": [
      "Artifact generation does not imply validation.",
      "Validation does not imply post-layout proof completion.",
      "Post-layout proof completion does not imply export freeze or publication authorization.",
      "Accessibility evidence is required only when the selected target-medium profile requires or claims it, but absence must be explicit rather than silently passing.",
      "A proof correction that changes bytes invalidates prior digest-bound validation/proof evidence."
    ]
  },
  "provenance_evidence_contract": {
    "currentness_states": ["NONE", "CURRENT_FOR_BOUND_SOURCE_AND_ARTIFACT", "SUPERSEDED_FOR_CURRENT_RELEASE", "REDACTION_OR_CORRECTION_REQUIRED", "WITHDRAWN_BY_PARENT_POLICY", "EXTERNAL_VALIDATION_FAILED"],
    "required_when_present": [
      "projection_type",
      "projection_version",
      "source_object_refs_and_digests",
      "bound_artifact_digest",
      "projection_ref",
      "projection_digest",
      "currentness_state",
      "validation_result"
    ],
    "rules": [
      "W3C PROV, C2PA and other registered external provenance remain evidence-only projections.",
      "A provenance projection cannot be rebound from old source/artifact bytes to new bytes.",
      "If credential attachment changes asset bytes, final credentialed artifact digest must differ from and preserve predecessor identity for the pre-credential digest.",
      "Private manuscript/evaluation/research content is excluded unless explicitly authorized and necessary."
    ]
  },
