{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-master://qualification/a01/receipt/v1",
  "title": "A-01 Qualification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "policy_version", "registry_version", "qualification_id", "workstream_id", "gate_class", "subject_sha", "checkout_sha", "requested_at", "started_at", "completed_at", "queue_ms", "execution_ms", "result_class", "runner", "evidence_artifact", "return_ticket", "promotion_authorized"],
  "properties": {
    "receipt_version": {"const": 1},
    "policy_version": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "integer", "minimum": 1},
    "qualification_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": "string", "minLength": 1},
    "gate_class": {"enum": ["focused", "consolidated", "promotion"]},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "checkout_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "requested_at": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "queue_ms": {"type": ["integer", "null"], "minimum": 0},
    "execution_ms": {"type": "integer", "minimum": 0},
    "result_class": {"enum": ["PASS", "SUBJECT_FAILURE", "INFRA_FAILURE", "CONTROL_PLANE_FAILURE"]},
    "child_exit_code": {"type": ["integer", "null"]},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "os", "arch", "required_labels"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "os": {"type": ["string", "null"]},
        "arch": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "required_labels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_artifact": {"type": "string", "minLength": 1},
    "return_ticket": {"$ref": "return-ticket.schema.json"},
    "promotion_authorized": {"type": "boolean"}
  }
}
