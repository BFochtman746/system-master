{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system-master://qualification/a01/return-ticket/v1",
  "title": "A-01 Return Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["workstream_id", "qualification_id", "subject_sha", "origin_ref", "resume_on_pass", "resume_on_failure", "notification_target"],
  "properties": {
    "workstream_id": {"type": "string", "minLength": 1},
    "qualification_id": {"type": "string", "minLength": 1},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "origin_ref": {"type": "string", "minLength": 1},
    "resume_on_pass": {"type": "string", "minLength": 1},
    "resume_on_failure": {"type": "string", "minLength": 1},
    "notification_target": {"type": "string", "minLength": 1}
  }
}
