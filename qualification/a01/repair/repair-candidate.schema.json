{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:system-master:a01:repair-candidate:v1",
  "title": "A-01 Closed-Loop Repair Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "qualification_id",
    "workstream_id",
    "failed_subject_sha",
    "candidate_sha",
    "attempt",
    "repair_scope",
    "repair_worker",
    "prequalification",
    "return_ticket"
  ],
  "properties": {
    "version": {"const": 1},
    "qualification_id": {"type": "string", "minLength": 1},
    "workstream_id": {"type": "string", "minLength": 1},
    "failed_subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 20},
    "repair_scope": {"type": "string", "minLength": 1, "maxLength": 2000},
    "blocker_class": {
      "type": ["string", "null"],
      "enum": [null, "HUMAN_ONLY", "AUTHOR_ONLY", "PRIVATE_DATA", "NATIVE_PLATFORM", "EXTERNAL_AUTHORITY", "SOURCE_CUSTODY", "UNSAFE_TO_AUTOREPAIR"]
    },
    "repair_worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "changed_bytes", "evidence_ref"],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "changed_bytes": {"const": true},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "prequalification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "subject_sha", "evidence_ref"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "return_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_ref", "resume_on_pass", "resume_on_failure", "notification_target"],
      "properties": {
        "origin_ref": {"type": "string", "minLength": 1},
        "resume_on_pass": {"type": "string", "minLength": 1},
        "resume_on_failure": {"type": "string", "minLength": 1},
        "notification_target": {"type": "string", "minLength": 1}
      }
    }
  }
}
