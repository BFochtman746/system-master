{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-master.local/qualification/a01/overnight/ticket.schema.json",
  "title": "A01 Overnight Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_version",
    "ticket_id",
    "state",
    "night_date",
    "submitted_at",
    "workstream_id",
    "qualification_id",
    "subject_sha",
    "origin_ref",
    "estimated_minutes",
    "max_runtime_minutes",
    "priority",
    "earliest_start_local",
    "latest_start_local",
    "window_end_local",
    "exclusive_window",
    "resume_on_pass",
    "resume_on_failure",
    "notification_target"
  ],
  "properties": {
    "ticket_version": {"const": 1},
    "ticket_id": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$"},
    "state": {"enum": ["READY", "HOLD", "SUPERSEDED"]},
    "night_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "workstream_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "qualification_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "subject_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "origin_ref": {"type": "string", "minLength": 1, "maxLength": 300},
    "depends_on_ticket_id": {"type": ["string", "null"], "minLength": 3, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$"},
    "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 300},
    "max_runtime_minutes": {"type": "integer", "minimum": 1, "maximum": 300},
    "priority": {"type": "integer", "minimum": 1, "maximum": 100},
    "earliest_start_local": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "latest_start_local": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "window_end_local": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "exclusive_window": {"type": "boolean"},
    "checkpoint_interval_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
    "resource_class": {"enum": ["cpu", "memory", "io", "network", "mixed"]},
    "overnight_lane": {"enum": ["FINISH", "BUILD_AHEAD", "RESEARCH_AHEAD", "PREPARE_NEXT", "EXPLORE"]},
    "value_class": {"type": "string", "minLength": 1, "maxLength": 120},
    "critical_path_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 99},
    "completion_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "evidence", "after_pass", "unlocks"],
      "properties": {
        "before": {"type": "string", "minLength": 1, "maxLength": 1200},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 1200},
        "after_pass": {"type": "string", "minLength": 1, "maxLength": 1200},
        "unlocks": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "stop_condition": {"type": "string", "minLength": 1, "maxLength": 1600},
    "resume_on_pass": {"type": "string", "minLength": 1, "maxLength": 1600},
    "resume_on_failure": {"type": "string", "minLength": 1, "maxLength": 1600},
    "notification_target": {"type": "string", "minLength": 1, "maxLength": 200},
    "notes": {"type": "string", "maxLength": 4000}
  }
}
