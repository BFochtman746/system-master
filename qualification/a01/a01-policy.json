{
  "policy_version": 9,
  "control_plane_id": "A01-CONTROL-PLANE-001",
  "canonical_ref": "main",
  "runner": {
    "name": "A-01",
    "required_labels": ["self-hosted", "Windows", "X64"],
    "global_concurrency_group": "a01-global-r2",
    "concurrency_generation": 2,
    "queue_mode": "max",
    "queue_capacity": 100,
    "unavailable_state": "WAITING_FOR_RUNNER",
    "github_queue_expiry_hours": 24,
    "assignment_requeue_seconds": 60,
    "health": {
      "min_free_disk_gb": 10,
      "min_available_memory_gb": 4,
      "require_node": true,
      "require_git": true,
      "prevent_system_sleep_during_qualification": true,
      "record_preflight_postflight": true,
      "cleanup_stale_a01_temp_after_hours": 24,
      "cleanup_is_best_effort": true,
      "fail_closed_on_identity_or_resource_guard": true,
      "memory_profile": {
        "mode": "UNIFIED_VGM_SPLIT",
        "unified_total_gb": 128,
        "configured_vgm_gb": 96,
        "unified_total_tolerance_gb": 2,
        "min_commit_headroom_gb": 8,
        "low_physical_memory_behavior": "WARN_WHEN_PROFILE_MATCHES_AND_COMMIT_HEADROOM_IS_SAFE"
      }
    }
  },
  "admission": {
    "mode": "TRUSTED_SELF_HOSTED_METADATA_ONLY_FOR_NONDISRUPTIVE",
    "max_outstanding_per_workstream": 4,
    "require_registered_qualification": true,
    "allow_arbitrary_command_input": false,
    "continue_dependency_valid_work_while_waiting": true,
    "hosted_barrier_required_before_self_hosted_runner": false,
    "trusted_metadata_barrier_required_before_subject_checkout": true,
    "pre_admission_subject_checkout_forbidden": true,
    "pre_admission_subject_execution_forbidden": true,
    "verify_control_plane_sha_before_admission": true,
    "verify_subject_commit_metadata_before_subject_checkout": true,
    "verify_registered_wrapper_metadata_before_subject_checkout": true,
    "non_disruptive_only_without_hosted_runner": true,
    "disruptive_qualifications_fail_closed_without_hosted_admission": true,
    "blocked_requests_may_acquire_trusted_admission_runner": true,
    "blocked_requests_must_not_checkout_or_execute_subject": true,
    "canonical_gateway": ".github/workflows/a01-control-plane-gateway.yml",
    "trusted_admission_broker": ".github/workflows/a01-control-plane-admission-broker.yml",
    "self_hosted_executor": ".github/workflows/a01-control-plane-executor.yml"
  },
  "retry": {
    "after_registry_policy_or_gateway_change": "FRESH_WORKFLOW_DISPATCH_OR_FRESH_CALLER_RUN_REQUIRED",
    "failed_job_or_specific_job_rerun_may_reuse_old_reusable_workflow_sha": true,
    "stale_control_plane_admission_result": "FAIL_CLOSED_BEFORE_SUBJECT_CHECKOUT_AND_REQUIRE_FRESH_RUN",
    "same_control_plane_subject_retry": "FRESH_RUN_PREFERRED",
    "never_treat_rerun_as_control_plane_refresh": true
  },
  "gate_classes": {
    "focused": {"purpose": "Changed capability plus immediate integration dependencies", "promotion_authority": false},
    "consolidated": {"purpose": "Accumulated slice plus broader regressions", "promotion_authority": false},
    "promotion": {"purpose": "Exact promotion subject and required regressions", "promotion_authority": true}
  },
  "runtime": {
    "normal_qualifier_timeout_minutes": 28,
    "normal_job_timeout_minutes": 30,
    "cleanup_margin_minutes": 10,
    "max_qualifier_timeout_minutes": 300,
    "max_job_timeout_minutes": 310
  },
  "overnight": {
    "enabled": true,
    "timezone": "America/New_York",
    "window_start_local": "00:00",
    "window_end_local": "07:00",
    "scheduler_kickoff_local": "23:57",
    "max_slots": 8,
    "transition_buffer_minutes": 2,
    "max_ticket_runtime_minutes": 300,
    "checkpoint_required_above_minutes": 180,
    "max_checkpoint_interval_minutes": 30,
    "one_ready_ticket_per_workstream_per_night": false,
    "max_ready_tickets_per_workstream_per_night": 4,
    "dependency_chains": {
      "enabled": true,
      "same_workstream_only": true,
      "depends_on_ticket_id_requires_predecessor_pass": true,
      "dependent_ticket_must_follow_predecessor_immediately": true,
      "max_chain_length": 4,
      "independent_tickets_continue_after_other_failures": true
    },
    "reject_disruptive_post_actions": true,
    "do_not_start_if_declared_budget_exceeds_remaining_window": true,
    "ordinary_work_may_backfill_before_reserved_windows": true,
    "independent_workstream_cron_prohibited": true,
    "allow_idle_capacity": true,
    "second_shift": {
      "enabled": true,
      "goal": "Maximize reduction in next-day work, uncertainty, waiting, and critical-path distance rather than raw runner utilization.",
      "require_completion_delta_for_ready": true,
      "require_stop_condition_for_ready": true,
      "lanes": ["FINISH", "BUILD_AHEAD", "RESEARCH_AHEAD", "PREPARE_NEXT", "EXPLORE"],
      "lane_order": ["FINISH", "BUILD_AHEAD", "RESEARCH_AHEAD", "PREPARE_NEXT", "EXPLORE"],
      "research_must_produce": ["source_provenance", "gap_or_question_answered", "implementation_or_evaluation_implication", "next_day_handoff"],
      "build_ahead_requires": ["bounded_scope", "repository_owned_tests_or_acceptance", "no_human_decision_dependency", "no_promotion_without_registered_gate"],
      "never_create_work_for_utilization": true
    }
  },
  "post_actions": {
    "allowed": ["windows_reboot"],
    "receipt_before_action": true,
    "evidence_upload_before_action": true,
    "verification_required_after_disruptive_action": true,
    "windows_reboot_delay_seconds": 30,
    "disruption_settle_seconds": 90,
    "trusted_metadata_fallback_supported": false,
    "strategy": "Disruptive qualifications remain fail-closed unless an independently available hosted settle/admission path is restored; policy v8 metadata-only self-hosted admission is non-disruptive only."
  },
  "states": ["BUILDING", "PREQUALIFIED", "A01_ELIGIBLE", "A01_QUEUED", "A01_RUNNING", "A01_FAILED", "A01_PASSED", "REPAIR_REQUIRED", "SUPERSEDED", "PROMOTION_ELIGIBLE", "CANONICAL"],
  "result_classes": ["PASS", "SUBJECT_FAILURE", "INFRA_FAILURE", "CONTROL_PLANE_FAILURE"],
  "admission_states": ["ADMITTED", "WAITING_FOR_REGISTRATION", "REGISTERED_EXECUTABLE_MISSING", "WORKSTREAM_MISMATCH", "INVALID_SUBJECT_SHA", "SUBJECT_CHECKOUT_MISMATCH", "SUBJECT_METADATA_READ_FAILURE", "SUBJECT_METADATA_IDENTITY_MISMATCH", "SUBJECT_METADATA_TREE_TRUNCATED", "CONTROL_PLANE_CHECKOUT_MISMATCH", "INVALID_CONTROL_PLANE_POLICY", "INVALID_REGISTRY", "INVALID_REGISTERED_WRAPPER_PATH", "INVALID_REGISTERED_WRAPPER_SOURCE", "INVALID_EXECUTION_CONTEXT", "INVALID_QUALIFIER_TIMEOUT", "QUALIFICATION_NOT_OVERNIGHT_ELIGIBLE", "QUALIFIER_TIMEOUT_EXCEEDS_REGISTRY", "DISRUPTIVE_QUALIFICATION_NOT_ALLOWED_OVERNIGHT", "DISRUPTIVE_QUALIFICATION_REQUIRES_HOSTED_BARRIER", "CONTROL_PLANE_READ_FAILURE"],
  "stale_request_policy": {
    "queued_superseded_subject": "SUPERSEDE",
    "running_superseded_subject": "FINISH_IF_EVIDENCE_USEFUL",
    "disconnected_disruptive_run": "DO_NOT_ADMIT_THROUGH_METADATA_ONLY_FALLBACK",
    "registry_or_policy_changed_after_run_creation": "DO_NOT_RERUN_FAILED_OR_SPECIFIC_JOB_FOR_REFRESH; START_FRESH_RUN"
  },
  "receipt": {
    "schema": "qualification/a01/schema/qualification-receipt.schema.json",
    "require_subject_checkout_match": true,
    "require_control_plane_sha_binding": true,
    "require_evidence": true,
    "promotion_requires_pass": true
  },
  "return_ticket": {"schema": "qualification/a01/schema/return-ticket.schema.json", "required": true}
}
