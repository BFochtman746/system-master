{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "A01-CODE-QUAL-001-RECEIPT-SCHEMA-001",
  "title": "A-01 Hosted Coding Qualification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "contract_id",
    "operation_id",
    "authoring_subject_identity",
    "benchmark_subject_sha256",
    "hidden_evaluator_sha256",
    "assignment_sha256",
    "starting_git_sha",
    "final_git_sha",
    "start_timestamp_utc",
    "stop_timestamp_utc",
    "elapsed_seconds",
    "deadline_enforced",
    "candidate_isolation_enforced",
    "human_assistance",
    "a01_host_evidence",
    "visible_tests",
    "hidden_tests",
    "coverage",
    "complexity",
    "duplication",
    "concurrency_recovery",
    "security_failure_safety",
    "scope_discipline",
    "first_pass_quality",
    "raw_artifact_digest",
    "receipt_digest"
  ],
  "properties": {
    "protocol_version": {"const": "a01.code-qualification-receipt.v1"},
    "contract_id": {"const": "A01-CODE-QUAL-001-30-MINUTE-SEALED-CODING-STRESS-BASELINE-CONTRACT-001"},
    "operation_id": {"const": "A01-CODE-QUAL-001"},
    "authoring_subject_identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "provider_or_runtime",
        "authoring_entrypoint_identity",
        "system_or_project_instruction_digest",
        "tool_permission_profile_digest"
      ],
      "properties": {
        "provider_or_runtime": {"type": "string", "minLength": 1},
        "authoring_entrypoint_identity": {"type": "string", "minLength": 1},
        "system_or_project_instruction_digest": {"$ref": "#/$defs/sha256"},
        "tool_permission_profile_digest": {"$ref": "#/$defs/sha256"},
        "agent_or_model_name": {"type": ["string", "null"]},
        "agent_or_model_version": {"type": ["string", "null"]},
        "reasoning_or_effort_configuration": {"type": ["string", "null"]}
      }
    },
    "benchmark_subject_sha256": {"$ref": "#/$defs/sha256"},
    "hidden_evaluator_sha256": {"$ref": "#/$defs/sha256"},
    "assignment_sha256": {"$ref": "#/$defs/sha256"},
    "starting_git_sha": {"$ref": "#/$defs/gitSha"},
    "final_git_sha": {"$ref": "#/$defs/gitSha"},
    "start_timestamp_utc": {"type": "string", "format": "date-time"},
    "stop_timestamp_utc": {"type": "string", "format": "date-time"},
    "elapsed_seconds": {"type": "number", "minimum": 0, "maximum": 1800.999},
    "deadline_enforced": {"const": true},
    "candidate_isolation_enforced": {"const": true},
    "human_assistance": {"const": false},
    "a01_host_evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runner_name", "operating_system", "architecture", "freeze_artifact_sha256"],
      "properties": {
        "runner_name": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "freeze_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "visible_tests": {"$ref": "#/$defs/testResult"},
    "hidden_tests": {"$ref": "#/$defs/testResult"},
    "coverage": {"type": "object"},
    "complexity": {"type": "object"},
    "duplication": {"type": "object"},
    "concurrency_recovery": {"type": "object"},
    "security_failure_safety": {"type": "object"},
    "scope_discipline": {"type": "object"},
    "first_pass_quality": {"type": "object"},
    "raw_artifact_digest": {"$ref": "#/$defs/sha256"},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "testResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["passed", "failed"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
