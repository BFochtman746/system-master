{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"system-master/continuity/target-ios-client-suspend-resume-evidence-v1",
  "type":"object",
  "additionalProperties":false,
  "required":["evidence_class","qualification_id","subject_commit","runtime","client","work_unit_id","lifecycle","reconnect","command_reconciliation","requirements","observed_at_utc","evidence_digest"],
  "properties":{
    "evidence_class":{"const":"TARGET_IOS_CLIENT_SUSPEND_RESUME"},
    "qualification_id":{"const":"CONTINUITY-IOS-SUSPEND-RESUME-001"},
    "subject_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "runtime":{
      "type":"object","additionalProperties":false,
      "required":["platform","os_version","runtime_kind","device_or_simulator_id"],
      "properties":{
        "platform":{"const":"iOS"},
        "os_version":{"type":"string","minLength":1},
        "runtime_kind":{"enum":["IOS_SIMULATOR","IOS_PHYSICAL_DEVICE"]},
        "device_or_simulator_id":{"type":"string","minLength":1}
      }
    },
    "client":{
      "type":"object","additionalProperties":false,
      "required":["bundle_id","build_id","launch_instance_before","launch_instance_after"],
      "properties":{
        "bundle_id":{"type":"string","minLength":1},
        "build_id":{"type":"string","minLength":1},
        "launch_instance_before":{"type":"string","minLength":1},
        "launch_instance_after":{"type":"string","minLength":1}
      }
    },
    "work_unit_id":{"type":"string","minLength":1},
    "lifecycle":{
      "type":"object","additionalProperties":false,
      "required":["background_or_suspend_observed","reactivation_observed","events"],
      "properties":{
        "background_or_suspend_observed":{"const":true},
        "reactivation_observed":{"const":true},
        "events":{"type":"array","minItems":2,"items":{"type":"object","required":["event","observed_at_utc"],"properties":{"event":{"type":"string"},"observed_at_utc":{"type":"string"}}}}
      }
    },
    "reconnect":{
      "type":"object","additionalProperties":false,
      "required":["same_work_unit_id","ephemeral_session_required","status_queried_after_reactivation","progress_basis_explicit"],
      "properties":{
        "same_work_unit_id":{"const":true},
        "ephemeral_session_required":{"const":false},
        "status_queried_after_reactivation":{"const":true},
        "progress_basis_explicit":{"const":true}
      }
    },
    "command_reconciliation":{
      "type":"object","additionalProperties":false,
      "required":["unknown_outcome_exercised","reconcile_before_recommand","duplicate_effect_observed","command_id"],
      "properties":{
        "unknown_outcome_exercised":{"const":true},
        "reconcile_before_recommand":{"const":true},
        "duplicate_effect_observed":{"const":false},
        "command_id":{"type":"string","minLength":1}
      }
    },
    "requirements":{
      "type":"object","additionalProperties":false,
      "required":["G-RQ-049","G-RQ-050","G-RQ-072"],
      "properties":{
        "G-RQ-049":{"const":"PASS"},
        "G-RQ-050":{"const":"PASS"},
        "G-RQ-072":{"const":"PASS_TARGET_IOS_ARM_ONLY"}
      }
    },
    "observed_at_utc":{"type":"string","minLength":1},
    "evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
