name: A01 Governed Production Bootstrap Qualification

on:
  workflow_dispatch:
  pull_request:
    branches:
      - main
    paths:
      - 'control-gateway/src/development-response-production-enforcement.js'
      - 'control-gateway/test/development-response-production-enforcement.test.js'
      - '.github/scripts/control-gateway-production-writer.js'
      - '.github/scripts/control-gateway-authority-bootstrap.js'
      - '.github/workflows/control-gateway-production-writer.yml'
      - '.github/workflows/control-gateway-native-command-ingress.yml'
      - '.github/workflows/control-gateway-native-bootstrap-ingress.yml'
      - '.github/workflows/a01-governed-production-bootstrap-qualification.yml'

permissions:
  contents: read

jobs:
  qualify:
    name: Governed production bootstrap / Node ${{ matrix.node }}
    runs-on: ubuntu-latest
    timeout-minutes: 10

    strategy:
      fail-fast: false
      matrix:
        node: [22, 24]

    steps:
      - name: Checkout exact subject
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 1
          persist-credentials: false

      - name: Set up Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: ${{ matrix.node }}

      - name: Verify exact subject
        shell: bash
        env:
          SUBJECT_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "${SUBJECT_SHA}"
          echo "SUBJECT_SHA=${SUBJECT_SHA}"
          node --version

      - name: Run governed production enforcement qualification
        working-directory: control-gateway
        run: node --test test/development-response-production-enforcement.test.js