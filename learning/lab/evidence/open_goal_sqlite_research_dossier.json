            },
            {
              "column": "title",
              "direction": "ASC"
            }
          ]
        },
        "prompt": "Return title and priority for incomplete tasks, highest priority first and title ascending for ties.",
        "scoring_type": "SQLITE_QUERY"
      },
      {
        "answer": "SELECT owner, title FROM tasks WHERE priority >= 2 ORDER BY owner ASC, title ASC",
