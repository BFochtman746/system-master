{
  "bundle_id": "OPEN-BUNDLE-SQLITE-QUERY-001",
  "bundle_version": "1.0.0",
  "claims": [
    {
      "claim_id": "CL-SQL-001",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-SELECT",
      "text": "In a simple SQLite SELECT, the result expression list determines which result columns are produced from the input rows."
    },
    {
      "claim_id": "CL-SQL-002",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-SELECT",
      "text": "When a WHERE clause is present, SQLite evaluates its expression for each input row and filters the input before result rows are produced."
    },
    {
      "claim_id": "CL-SQL-003",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-EXPR",
      "text": "SQLite comparison expressions can be used inside WHERE conditions to test row values, including equality and ordered comparisons."
    },
    {
      "claim_id": "CL-SQL-004",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-SELECT",
      "text": "If a SELECT returns multiple rows without ORDER BY, SQLite does not define the order in which those rows are returned."
    },
    {
      "claim_id": "CL-SQL-005",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-SELECT",
      "text": "An ORDER BY clause determines result-row ordering from its expressions; ASC orders smaller values first and DESC orders larger values first."
    },
    {
      "claim_id": "CL-SQL-006",
      "kind": "FACT",
      "source_id": "SRC-SQLITE-SELECT",
      "text": "When multiple ORDER BY expressions are present, SQLite sorts by the left-most expression first and uses later expressions to break ties."
    }
  ],
  "course_blueprint": {
    "criteria": [
      {
        "criterion_id": "C-SQL-SELECT-WHERE",
        "outcome": "Write a SQLite SELECT that returns specified columns and filters rows with a WHERE condition.",
        "skill_id": "S-SQL-SELECT-WHERE"
      },
      {
        "criterion_id": "C-SQL-ORDER",
        "outcome": "Add an ORDER BY clause that produces the requested deterministic row order, including tie-breaking when needed.",
        "skill_id": "S-SQL-ORDER"
      }
    ],
    "items": [
      {
        "answer": "SELECT title FROM tasks WHERE done = 0",
        "claim_refs": [
          "CL-SQL-001",
          "CL-SQL-002"
        ],
        "criterion_id": "C-SQL-SELECT-WHERE",
        "family_id": "F-SQL-WHERE-P1",
        "item_id": "P-SQL-WHERE-1",
        "mode": "PRACTICE",
        "oracle_spec": {
          "columns": [
            "title"
          ],
          "filter": {
            "column": "done",
            "op": "=",
            "value": 0
          }
        },
        "prompt": "Write a SQLite query returning only title for tasks with done = 0.",
        "scoring_type": "SQLITE_QUERY"
      },
      {
        "answer": "SELECT title, owner FROM tasks WHERE priority >= 2",
        "claim_refs": [
          "CL-SQL-001",
          "CL-SQL-002",
          "CL-SQL-003"
        ],
        "criterion_id": "C-SQL-SELECT-WHERE",
        "family_id": "F-SQL-WHERE-P2",
        "item_id": "P-SQL-WHERE-2",
        "mode": "PRACTICE",
        "oracle_spec": {
          "columns": [
            "title",
            "owner"
          ],
          "filter": {
            "column": "priority",
            "op": ">=",
            "value": 2
          }
        },
        "prompt": "Write a SQLite query returning title and owner for tasks where priority >= 2.",
        "scoring_type": "SQLITE_QUERY"
      },
      {
        "answer": "SELECT title, priority FROM tasks WHERE owner = 'Ava'",
        "claim_refs": [
          "CL-SQL-001",
          "CL-SQL-002",
          "CL-SQL-003"
        ],
        "criterion_id": "C-SQL-SELECT-WHERE",
        "family_id": "F-SQL-WHERE-M1",
        "item_id": "M-SQL-WHERE-1",
        "mode": "MASTERY_CHECK",
        "oracle_spec": {
          "columns": [
            "title",
            "priority"
          ],
          "filter": {
            "column": "owner",
            "op": "=",
            "value": "Ava"
          }
        },
        "prompt": "Write a query returning title and priority for tasks owned by Ava.",
        "scoring_type": "SQLITE_QUERY"
      },
      {
        "answer": "SELECT title, owner FROM tasks WHERE priority <= 1",
        "claim_refs": [
          "CL-SQL-001",
          "CL-SQL-002",
          "CL-SQL-003"
        ],
        "criterion_id": "C-SQL-SELECT-WHERE",
        "family_id": "F-SQL-WHERE-R1",
        "item_id": "R-SQL-WHERE-1",
        "mode": "RETENTION_CHECK",
        "oracle_spec": {
          "columns": [
            "title",
            "owner"
          ],
          "filter": {
            "column": "priority",
            "op": "<=",
            "value": 1
          }
        },
        "prompt": "Write a query returning title and owner for tasks where priority <= 1.",
        "scoring_type": "SQLITE_QUERY"
      },
      {
        "answer": "SELECT title, priority FROM tasks WHERE done = 0 ORDER BY priority DESC, title ASC",
        "claim_refs": [
          "CL-SQL-002",
